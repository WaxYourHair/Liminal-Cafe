# ---------- Database (MySQL 8) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campervan
DB_PASSWORD=ganti_password_database
DB_NAME=campervan_cafe
# Set to "true" for cloud MySQL that requires TLS (TiDB Cloud, Aiven, PlanetScale, Railway public proxy).
DB_SSL=false
# Optional: one connection string instead of the DB_* values above (e.g. Railway MYSQL_URL).
# DATABASE_URL=mysql://user:pass@host:3306/campervan_cafe

# ---------- Session ----------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter_xxxxxxxx
# Session length in hours (a full shift plus margin).
SESSION_HOURS=14

# ---------- Default accounts (only used by `npm run db:seed`) ----------
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ganti_password_admin
SEED_KASIR_NAME=Kasir
SEED_KASIR_USERNAME=kasir
SEED_KASIR_PASSWORD=ganti_password_kasir

# ---------- Google Sheets (optional) ----------
# Leave empty to run without Google Sheets. Transactions still work; sync events wait in the queue.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Option A (local/server with files): path to the service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Option B (cloud hosts): the whole JSON key, base64 encoded. Takes priority over option A.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ---------- Background sync ----------
# "true" runs the sync worker inside the server process every minute (Railway, VPS, local).
# Set "false" on serverless hosts (Vercel) and call /api/cron/sync from a scheduler instead.
SYNC_WORKER_ENABLED=true
# Protects /api/cron/sync. Send as header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=ganti_dengan_string_acak

# ---------- App ----------
APP_TIMEZONE=Asia/Jakarta
